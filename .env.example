# Application paths are resolved from the repository root.
DEAL_INTEL_ENVIRONMENT=local
DEAL_INTEL_DATA_ROOT=synthetic_data
DEAL_INTEL_SQLITE_PATH=var/deal_intel.sqlite
DEAL_INTEL_PROMPT_ROOT=src/deal_intel/reasoning_plane/prompts
DEAL_INTEL_ARTIFACT_DIR=var/artifacts
DEAL_INTEL_MAX_EVIDENCE_ITEMS=40

# LiteLLM OpenAI-compatible proxy.
LITELLM_BASE_URL=http://localhost:4000
LITELLM_HEALTH_PATH=/health
LITELLM_TIMEOUT_SECONDS=180
LITELLM_VERIFY_TLS=true
LITELLM_API_KEY=

# Replace these with model IDs returned by the authenticated /v1/models endpoint.
LITELLM_EXTRACTION_MODEL=gpt-5.6-luna
LITELLM_RISK_MODEL=gpt-5.6-sol
LITELLM_SYNTHESIS_MODEL=gpt-5.6-luna
LITELLM_TEMPERATURE=1
LITELLM_MAX_OUTPUT_TOKENS=4000
LITELLM_SYNTHESIS_MAX_OUTPUT_TOKENS=1800
